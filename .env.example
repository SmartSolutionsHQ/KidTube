# Optional. A first install needs no .env: the app makes its own secret and database, and the setup
# page in the browser asks for the rest. Anything set here locks that setting in the browser.
# Copy this file to .env and uncomment only what you need.

# Your family's web address. Required for HTTPS with compose.https.yaml (Caddy uses it).
# SITE_URL=https://videos.example.com

# Made for you in data/secret on first start. Set it only to manage secrets yourself (32+ characters).
# SIGN_SECRET=

# Email starts off; turn it on in setup or here.
# MAIL_MODE=brevo
# BREVO_API_KEY=
# NOTIFY_EMAIL=parent@example.com
# SENDER_EMAIL=videos@example.com

# Your family's name, tagline and accent color. Keep the quotes on the accent: .env reads an unquoted #
# as a comment.
# SITE_NAME=The Example Tapes
# SITE_TAGLINE=A little channel. A big imagination.
# FAMILY_ACCENT="#FF5C2B"

# npm start: where it listens. Docker: HOST_PORT is the port on this computer, and HOST_BIND=0.0.0.0
# lets phones on your home network reach it over plain http (the setup page warns about that).
# HOST=127.0.0.1
# PORT=3000
# HOST_PORT=3000
# HOST_BIND=127.0.0.1

# Docker on Linux: the user and group that own the data. Default 1000:1000.
# PUID=1000
# PGID=1000

# Docker installs that keep their data in the ./data folder (installs from before the setup page).
# KIDTUBE_DATA=./data

# Enable only behind a trusted proxy which overwrites X-Forwarded-For and X-Forwarded-Proto.
# TRUST_PROXY=1
