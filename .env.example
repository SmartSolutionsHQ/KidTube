# npm run setup creates .env and a unique parent account.
SITE_URL=http://localhost:3000
SIGN_SECRET=
MAIL_MODE=disabled
BREVO_API_KEY=
NOTIFY_EMAIL=parent@example.com
SENDER_EMAIL=videos@example.com
HOST=127.0.0.1
PORT=3000
PUID=1000
PGID=1000
# Enable only behind a trusted proxy which overwrites X-Forwarded-For.
TRUST_PROXY=0
